{
  "entities": {
    "Variation": {
      "title": "Variation",
      "description": "A product variation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isOutOfStock": { "type": "boolean" },
        "group": { "type": "string", "enum": ["5", "10", "other"] }
      },
      "required": ["id", "name", "isOutOfStock"]
    },
    "Product": {
      "title": "Product",
      "description": "A supermarket product.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "variations": {
          "type": "array",
          "items": { "$ref": "#/entities/Variation" }
        },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "imageUrl", "variations", "ownerId", "createdAt"]
    },
    "ReminderItem": {
      "title": "Reminder Item",
      "description": "A notebook reminder/shortage note item.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "completed", "createdBy", "createdAt"]
    },
    "ProfileCustomization": {
      "title": "Profile Customization",
      "description": "Customization options for user profile cards and banners.",
      "type": "object",
      "properties": {
        "bannerTheme": { "type": "string" },
        "bannerCustomUrl": { "type": "string" },
        "avatarFrame": { "type": "string" },
        "avatarShape": { "type": "string" },
        "cardTheme": { "type": "string" },
        "animatedEffect": { "type": "string" },
        "badgeTitle": { "type": "string" },
        "badgeIcon": { "type": "string" },
        "badgeColor": { "type": "string" },
        "fontStyle": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile for a user with gaming/custom themes and badges.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "customization": { "$ref": "#/entities/ProfileCustomization" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoUrl", "updatedAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products owned and managed by staff and users."
    },
    "reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/ReminderItem" },
      "description": "Shared notebook reminder/needed items."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and custom themes."
    }
  }
}

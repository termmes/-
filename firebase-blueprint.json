{
  "entities": {
    "Variation": {
      "title": "Variation",
      "description": "A product variation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isOutOfStock": { "type": "boolean" },
        "group": { "type": "string", "enum": ["5", "10", "other"] }
      },
      "required": ["id", "name", "isOutOfStock"]
    },
    "Product": {
      "title": "Product",
      "description": "A supermarket product.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "variations": {
          "type": "array",
          "items": { "$ref": "#/entities/Variation" }
        },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "imageUrl", "variations", "ownerId", "createdAt"]
    },
    "ReminderItem": {
      "title": "Reminder Item",
      "description": "A notebook reminder/shortage note item.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "completed": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "completed", "createdBy", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile for a user with Instagram-like features.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bio": { "type": "string" },
        "songUrl": { "type": "string" },
        "songTitle": { "type": "string" },
        "songArtist": { "type": "string" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoUrl", "updatedAt"]
    },
    "Story": {
      "title": "User Story",
      "description": "Instagram-style story for user profile and community.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "caption": { "type": "string" },
        "bgColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products owned by users."
    },
    "reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/ReminderItem" },
      "description": "Shared notebook reminder/needed items."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles."
    },
    "stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "User stories for community."
    }
  }
}

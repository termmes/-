rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model: مكتبه الهدى
    // ===============================================================
    //
    // Collection: products
    // Document ID: auto-generated or timestamp ID
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - imageUrl: string (required, 0-1000000 chars)
    //   - category: string (optional, 1-50 chars)
    //   - variations: list of objects (required, max 100 items)
    //   - ownerId: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: reminders
    // Document ID: auto-generated or timestamp ID
    // Fields:
    //   - text: string (required, 1-500 chars)
    //   - completed: bool (required)
    //   - createdBy: string (required)
    //   - authorName: string (optional, 0-100 chars)
    //   - createdAt: timestamp (required)
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields:
    //   - uid: string (required, matches auth.uid)
    //   - displayName: string (required, 1-100 chars)
    //   - photoUrl: string (required, 0-1000000 chars)
    //   - bio: string (optional, 0-500 chars)
    //   - email: string (optional, 0-150 chars)
    //   - role: string (optional, 0-50 chars)
    //   - customization: map (optional)
    //   - updatedAt: timestamp (required)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'kblox05@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function areValidVariations(variations) {
      return variations is list && variations.size() <= 100;
    }

    function isValidUserProfile() {
      return request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'bio', 'email', 'role', 'customization', 'updatedAt', 'songUrl', 'songTitle', 'songArtist', 'clipStartTime', 'clipDuration']) &&
             validStringLength('displayName', 1, 100) &&
             validStringLength('photoUrl', 0, 1000000) &&
             (!('bio' in request.resource.data) || validStringLength('bio', 0, 500)) &&
             (!('email' in request.resource.data) || validStringLength('email', 0, 150)) &&
             (!('role' in request.resource.data) || validStringLength('role', 0, 50)) &&
             (!('customization' in request.resource.data) || request.resource.data.customization is map) &&
             (!('songUrl' in request.resource.data) || validStringLength('songUrl', 0, 5000000)) &&
             (!('songTitle' in request.resource.data) || validStringLength('songTitle', 0, 150)) &&
             (!('songArtist' in request.resource.data) || validStringLength('songArtist', 0, 150)) &&
             request.resource.data.uid is string &&
             request.resource.data.updatedAt is timestamp;
    }

    function isValidProduct() {
      return (request.resource.data.keys().hasOnly(['name', 'imageUrl', 'variations', 'ownerId', 'createdAt']) ||
              request.resource.data.keys().hasOnly(['name', 'imageUrl', 'category', 'variations', 'ownerId', 'createdAt'])) &&
             validStringLength('name', 1, 100) &&
             validStringLength('imageUrl', 0, 1000000) &&
             (!('category' in request.resource.data) || validStringLength('category', 1, 50)) &&
             areValidVariations(request.resource.data.variations) &&
             request.resource.data.ownerId is string &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidReminderItem() {
      return (request.resource.data.keys().hasOnly(['text', 'completed', 'createdBy', 'createdAt']) ||
              request.resource.data.keys().hasOnly(['text', 'completed', 'createdBy', 'authorName', 'createdAt'])) &&
             validStringLength('text', 1, 500) &&
             request.resource.data.completed is bool &&
             request.resource.data.createdBy is string &&
             (!('authorName' in request.resource.data) || validStringLength('authorName', 0, 100)) &&
             request.resource.data.createdAt is timestamp;
    }

    // Products collection: Managed by store members
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProduct();
      allow update: if isAuthenticated() && isValidProduct();
      allow delete: if isAuthenticated();
    }

    // Notebook / Shortage reminders collection
    match /reminders/{reminderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidReminderItem();
      allow update: if isAuthenticated() && isValidReminderItem();
      allow delete: if isAuthenticated();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId && 
                       isValidUserProfile() && 
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
                       (request.auth.uid == userId || isAdmin()) && 
                       isValidUserProfile() && 
                       request.resource.data.uid == userId;
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
